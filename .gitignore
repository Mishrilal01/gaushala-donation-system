# Git ignore file for Gaushala Donation System

# Environment variables - NEVER commit these!
.env
.env.local
.env.*.local

# SQLite database (no longer used but just in case)
database.sqlite
*.db
*.sqlite
*.sqlite3

# Local file uploads (no longer used)
uploads/
server/uploads/

# Dependencies
node_modules/
npm-debug.log
yarn-error.log

# Build outputs
client/dist/
server/build/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
.DS_Store

# Testing
coverage/
.coverage

# Temporary files
temp/
tmp/
*.tmp

# Logs
logs/
*.log

# Package lock files (optional - some prefer to commit)
# package-lock.json
# yarn.lock
